# URL base de las rutas de cuentas montadas en el backend unificado.
# Para desarrollo local, la API y el portal comparten hostname (localhost).
# En producción Netlify usa /backend/auth para que la cookie sea same-origin.
VITE_API_URL=http://localhost:8000/auth
# URL del backend unificado que atiende el chat (POST /api/chat).
# En producción Netlify usa /backend.
VITE_CHAT_URL=http://localhost:8000
